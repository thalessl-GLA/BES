  list(
    "(1) Interaction"       = m_i3_eng,
    "(2) Interaction + Age" = m_i4_eng
  ),
  coef_rename = c(engl = "Englishness", earnings_median = "Local income (ASHE)",
                  "engl:earnings_median" = "Englishness × Local income", age = "Age"),
  gof_map = GOF_MAP,
  stars   = c("*" = .05, "**" = .01, "***" = .001),
