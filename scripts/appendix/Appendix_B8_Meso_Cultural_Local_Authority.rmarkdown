```{r setup, include=FALSE}
library(dplyr)
library(tidyr)
library(stringr)
library(lubridate)
library(fixest)
library(haven)
library(purrr)
library(modelsummary)
library(kableExtra)

options(modelsummary_factory_default = "kableExtra")

GOF_MAP <- tribble(
  ~raw,                  ~clean,          ~fmt,
  "nobs",                "Observations",  0,
  "FE: id",              "Individual FE", 0,
  "FE: wave",            "Wave FE",       0,
  "adj.r.squared",       "Adj. R²",       3,
  "within.r.squared",    "Within R²",     6,
  "rmse",                "RMSE",          3
)

df <- readRDS("~/Library/CloudStorage/OneDrive-UniversityofGlasgow/BES/BES/BES_subset_panel_full_v5_England.rds")

DV_BASE          <- "immigCultural"
BRIT_BASE        <- "britishness"
ENG_BASE         <- "englishness"
TIME_BASE        <- "starttime"
AGE_BASE         <- "age"
MESO_UNEMP_BASE  <- "unemployment_rate"
MESO_CLAIM_BASE  <- "claimant_rate"
MESO_INCOME_BASE <- "earnings_median"

get_wave <- function(x) as.integer(str_extract(x, "\\d+$"))

waves_available <- function(df, base) {
  vars <- names(df)[str_detect(names(df), paste0("^", base, "W\\d+$"))]
  sort(unique(map_int(vars, get_wave)))
}

make_meso_long <- function(df, base, out_name, waves_keep) {
  cols <- names(df) |> str_subset(paste0("^", base, "W\\d+$"))
  if (length(cols) == 0) return(NULL)
  tmp <- tibble(col = cols) |>
    mutate(wave = as.integer(str_extract(col, "\\d+$"))) |>
    filter(wave %in% waves_keep)
  if (nrow(tmp) == 0) return(NULL)
  use_cols <- tmp$col
  df |>
    select(id, all_of(use_cols)) |>
    mutate(across(all_of(use_cols),
                  ~ as.numeric(if (inherits(.x, "haven_labelled")) zap_labels(.x) else .x))) |>
    pivot_longer(cols = -id, names_to = "wave", values_to = out_name,
                 names_pattern = paste0("^", base, "W(\\d+)$")) |>
    mutate(wave = as.integer(wave))
}
```

```{r build-panels-brit, include=FALSE}
w_dv   <- waves_available(df, DV_BASE)
w_brit <- waves_available(df, BRIT_BASE)
w_time <- waves_available(df, TIME_BASE)
w_age  <- waves_available(df, AGE_BASE)

waves     <- Reduce(intersect, list(w_dv, w_brit, w_time))
waves_age <- intersect(waves, w_age)

core_cols <- c(
  paste0(DV_BASE,   "W", waves),
  paste0(BRIT_BASE, "W", waves),
  paste0(TIME_BASE, "W", waves),
  paste0(AGE_BASE,  "W", waves_age)
)

panel_long <- df |>
  mutate(across(any_of(core_cols), ~ {
    x <- .x; if (inherits(x, "haven_labelled")) x <- zap_labels(x); x
  })) |>
  select(id, any_of(core_cols)) |>
  pivot_longer(cols = -id, names_to = c(".value", "wave"),
               names_pattern = "(.+)W(\\d+)$") |>
  mutate(
    wave             = as.integer(wave),
    starttime_chr    = as.character(.data[[TIME_BASE]]),
    starttime_parsed = suppressWarnings(ymd_hms(starttime_chr, quiet = TRUE)),
    starttime_parsed = coalesce(starttime_parsed,
                                suppressWarnings(ymd(starttime_chr, quiet = TRUE))),
    year = year(starttime_parsed)
  ) |>
  rename(dv = all_of(DV_BASE), brit = all_of(BRIT_BASE), age = all_of(AGE_BASE)) |>
  mutate(dv = as.numeric(dv), brit = as.numeric(brit), age = as.numeric(age)) |>
  filter(!is.na(dv), !is.na(brit), !is.na(wave))

meso_unemp  <- make_meso_long(df, MESO_UNEMP_BASE,  "unemployment_rate", waves)
meso_claim  <- make_meso_long(df, MESO_CLAIM_BASE,  "claimant_rate",   waves)
meso_income <- make_meso_long(df, MESO_INCOME_BASE, "earnings_median",     waves)

panel_meso <- panel_long
if (!is.null(meso_unemp))  panel_meso <- left_join(panel_meso, meso_unemp,  by = c("id", "wave"))
if (!is.null(meso_claim))  panel_meso <- left_join(panel_meso, meso_claim,  by = c("id", "wave"))
if (!is.null(meso_income)) panel_meso <- left_join(panel_meso, meso_income, by = c("id", "wave"))

panel_meso_cat <- panel_meso |>
  mutate(brit = as.numeric(haven::zap_labels(brit)),
         age  = as.numeric(haven::zap_labels(age)),
         dv   = as.numeric(haven::zap_labels(dv))) |>
  filter(!is.na(dv), !is.na(brit), brit %in% 1:7, !is.na(wave))
```

```{r build-panels-engl, include=FALSE}
w_eng      <- waves_available(df, ENG_BASE)
waves_eng  <- Reduce(intersect, list(w_dv, w_eng, w_time))
waves_eng_age <- intersect(waves_eng, w_age)

core_cols_eng <- c(
  paste0(DV_BASE,  "W", waves_eng),
  paste0(ENG_BASE, "W", waves_eng),
  paste0(TIME_BASE,"W", waves_eng),
  paste0(AGE_BASE, "W", waves_eng_age)
)

panel_long_eng <- df |>
  mutate(across(any_of(core_cols_eng), ~ {
    x <- .x; if (inherits(x, "haven_labelled")) x <- zap_labels(x); x
  })) |>
  select(id, any_of(core_cols_eng)) |>
  pivot_longer(cols = -id, names_to = c(".value", "wave"),
               names_pattern = "(.+)W(\\d+)$") |>
  mutate(
    wave             = as.integer(wave),
    starttime_chr    = as.character(.data[[TIME_BASE]]),
    starttime_parsed = suppressWarnings(ymd_hms(starttime_chr, quiet = TRUE)),
    starttime_parsed = coalesce(starttime_parsed,
                                suppressWarnings(ymd(starttime_chr, quiet = TRUE))),
    year = year(starttime_parsed)
  ) |>
  rename(dv = all_of(DV_BASE), engl = all_of(ENG_BASE), age = all_of(AGE_BASE)) |>
  mutate(dv   = as.numeric(dv),
         engl = as.numeric(engl),
         age  = as.numeric(age),
         engl = dplyr::na_if(engl, 9999)) |>
  filter(!is.na(dv), !is.na(engl), engl %in% 1:7, !is.na(wave))

meso_unemp_eng  <- make_meso_long(df, MESO_UNEMP_BASE,  "unemployment_rate", waves_eng)
meso_claim_eng  <- make_meso_long(df, MESO_CLAIM_BASE,  "claimant_rate",   waves_eng)
meso_income_eng <- make_meso_long(df, MESO_INCOME_BASE, "earnings_median",     waves_eng)

panel_meso_eng <- panel_long_eng
if (!is.null(meso_unemp_eng))  panel_meso_eng <- left_join(panel_meso_eng, meso_unemp_eng,  by = c("id", "wave"))
if (!is.null(meso_claim_eng))  panel_meso_eng <- left_join(panel_meso_eng, meso_claim_eng,  by = c("id", "wave"))
if (!is.null(meso_income_eng)) panel_meso_eng <- left_join(panel_meso_eng, meso_income_eng, by = c("id", "wave"))

panel_meso_eng_cat <- panel_meso_eng |>
  mutate(engl = as.numeric(if (inherits(engl, "haven_labelled")) haven::zap_labels(engl) else engl),
         age  = as.numeric(if (inherits(age,  "haven_labelled")) haven::zap_labels(age)  else age),
         dv   = as.numeric(if (inherits(dv,   "haven_labelled")) haven::zap_labels(dv)   else dv),
         engl = dplyr::na_if(engl, 9999)) |>
  filter(!is.na(dv), !is.na(engl), engl %in% 1:7, !is.na(wave))
```

```{r estimate-brit, include=FALSE}
panel_u <- panel_meso     |> filter(!is.na(unemployment_rate))
panel_c <- panel_meso     |> filter(!is.na(claimant_rate))
panel_i <- panel_meso     |> filter(!is.na(earnings_median))

m_u0.1 <- feols(dv ~ unemployment_rate             | id + wave, data = panel_u, cluster = "id")
m_u1   <- feols(dv ~ brit + unemployment_rate       | id + wave, data = panel_u, cluster = "id")
m_u0.2 <- feols(dv ~ unemployment_rate + age        | id + wave, data = panel_u, cluster = "id")
m_u2   <- feols(dv ~ brit + unemployment_rate + age | id + wave, data = panel_u, cluster = "id")
m_u3   <- feols(dv ~ brit * unemployment_rate       | id + wave, data = panel_u, cluster = "id")
m_u4   <- feols(dv ~ brit * unemployment_rate + age | id + wave, data = panel_u, cluster = "id")

m_c0.1 <- feols(dv ~ claimant_rate               | id + wave, data = panel_c, cluster = "id")
m_c1   <- feols(dv ~ brit + claimant_rate         | id + wave, data = panel_c, cluster = "id")
m_c0.2 <- feols(dv ~ claimant_rate + age          | id + wave, data = panel_c, cluster = "id")
m_c2   <- feols(dv ~ brit + claimant_rate + age   | id + wave, data = panel_c, cluster = "id")
m_c3   <- feols(dv ~ brit * claimant_rate         | id + wave, data = panel_c, cluster = "id")
m_c4   <- feols(dv ~ brit * claimant_rate + age   | id + wave, data = panel_c, cluster = "id")

m_i0.1 <- feols(dv ~ earnings_median                 | id + wave, data = panel_i, cluster = "id")
m_i1   <- feols(dv ~ brit + earnings_median           | id + wave, data = panel_i, cluster = "id")
m_i0.2 <- feols(dv ~ earnings_median + age            | id + wave, data = panel_i, cluster = "id")
m_i2   <- feols(dv ~ brit + earnings_median + age     | id + wave, data = panel_i, cluster = "id")
m_i3   <- feols(dv ~ brit * earnings_median           | id + wave, data = panel_i, cluster = "id")
m_i4   <- feols(dv ~ brit * earnings_median + age     | id + wave, data = panel_i, cluster = "id")
```

```{r estimate-brit-cat, include=FALSE}
panel_u_cat <- panel_meso_cat |> filter(!is.na(unemployment_rate))
panel_c_cat <- panel_meso_cat |> filter(!is.na(claimant_rate))
panel_i_cat <- panel_meso_cat |> filter(!is.na(earnings_median))

m_u1_cat <- feols(dv ~ i(brit, ref = 7) + unemployment_rate       | id + wave, data = panel_u_cat, cluster = "id")
m_u2_cat <- feols(dv ~ i(brit, ref = 7) + unemployment_rate + age | id + wave, data = panel_u_cat, cluster = "id")
m_u3_cat <- feols(dv ~ i(brit, ref = 7) * unemployment_rate       | id + wave, data = panel_u_cat, cluster = "id")
m_u4_cat <- feols(dv ~ i(brit, ref = 7) * unemployment_rate + age | id + wave, data = panel_u_cat, cluster = "id")

m_c1_cat <- feols(dv ~ i(brit, ref = 7) + claimant_rate         | id + wave, data = panel_c_cat, cluster = "id")
m_c2_cat <- feols(dv ~ i(brit, ref = 7) + claimant_rate + age   | id + wave, data = panel_c_cat, cluster = "id")
m_c3_cat <- feols(dv ~ i(brit, ref = 7) * claimant_rate         | id + wave, data = panel_c_cat, cluster = "id")
m_c4_cat <- feols(dv ~ i(brit, ref = 7) * claimant_rate + age   | id + wave, data = panel_c_cat, cluster = "id")

m_i1_cat <- feols(dv ~ i(brit, ref = 7) + earnings_median           | id + wave, data = panel_i_cat, cluster = "id")
m_i2_cat <- feols(dv ~ i(brit, ref = 7) + earnings_median + age     | id + wave, data = panel_i_cat, cluster = "id")
m_i3_cat <- feols(dv ~ i(brit, ref = 7) * earnings_median           | id + wave, data = panel_i_cat, cluster = "id")
m_i4_cat <- feols(dv ~ i(brit, ref = 7) * earnings_median + age     | id + wave, data = panel_i_cat, cluster = "id")
```

