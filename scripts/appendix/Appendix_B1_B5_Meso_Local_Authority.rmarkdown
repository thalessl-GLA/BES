m_c1_eng   <- feols(dv ~ engl + claimant_rate         | id + wave, data = panel_c_eng, cluster = "id")
m_c0.2_eng <- feols(dv ~ claimant_rate + age          | id + wave, data = panel_c_eng, cluster = "id")
