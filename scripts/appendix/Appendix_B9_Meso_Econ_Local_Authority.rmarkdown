  list(
    "(1) Income only"   = m_i0.1_eng,
    "(2) + Englishness" = m_i1_eng,
    "(3) Income + Age"  = m_i0.2_eng,
    "(4) + Englishness" = m_i2_eng
  ),
  coef_rename = c(engl = "Englishness", earnings_median = "Local income (ASHE)", age = "Age"),
  gof_map = GOF_MAP,
  stars   = c("*" = .05, "**" = .01, "***" = .001),
  title   = "Table B8.17. Local Income (ASHE) and Economic Immigration Attitudes: Main Effects (Englishness)",
  notes   = "Individual and wave FE. SEs clustered by respondent. DV: immigEcon.",
  escape  = FALSE,
  output  = "kableExtra"
) |> kable_styling()
```

```{r b8-engl-income-int}
