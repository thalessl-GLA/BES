# ============================================================
# R / RStudio
# ============================================================

# History files
.Rhistory
.Rapp.history
.Rhistory_backup

# Session/workspace files
.RData
.RDataTmp
.RDataTmp*
.RData_backup

# User-specific files
.Ruserdata

# RStudio project state
.Rproj.user/

# R environment variables
.Renviron


# ============================================================
# R package/build files
# ============================================================

# Example code in package build process
*-Ex.R

# R CMD build/check output
/*.tar.gz
/*.Rcheck/

# Produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token
.httr-oauth

# RStudio Connect
rsconnect/


